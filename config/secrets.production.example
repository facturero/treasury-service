# Plantilla de los secretos de producción de treasury-service. NO se sube tal cual: se copia a secrets.production.dec, se rellena
# y se cifra con SOPS (clave age de .sops.yaml) a config/secrets.production.enc, que es lo único que va al repo:
#
#   cp config/secrets.production.example /tmp/treasury.env   # rellenar
#   SOPS_AGE_KEY_FILE=~/.config/sops/age/keys.txt sops -e --input-type dotenv --output-type dotenv /tmp/treasury.env > config/secrets.production.enc
#   rm /tmp/treasury.env
#
# Cuidado: el archivo con LF, sin retorno de carro (CRLF). Un \r al final de DB_HOST o DB_USER rompe la conexión (nos pasó con accounting).
# La base y el usuario se crean una vez en el MySQL del clúster:
#   CREATE DATABASE IF NOT EXISTS treasury_db CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;
#   CREATE USER IF NOT EXISTS 'treasury_user'@'%' IDENTIFIED BY '<contraseña fuerte nueva>';
#   GRANT ALL PRIVILEGES ON treasury_db.* TO 'treasury_user'@'%';
DB_HOST=mysql-basic
DB_PORT=3306
DB_USER=treasury_user
DB_PASSWORD=<la contraseña de treasury_user>
DB_NAME=treasury_db
RABBITMQ_URL=amqp://rabbitmq:5672
